#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  echo "$0 [iterm|kitty|loupe|sixels|symbols]" >&2
  exit 1
}

# shellcheck source=/dev/null
source "$ROOT_DIR/utils/source.sh"
source_modules \
  utils/database.sh

main() {
  local format
  [ "$#" -le 1 ] || usage
  database_prepare
  if [ "$#" -eq 0 ]; then
    printf '%s\n' "$SCRY_DISPLAY_FORMAT"
    return 0
  fi
  format=$1
  case "$format" in
    iterm | kitty | loupe | sixels | symbols) ;;
    *) usage ;;
  esac
  database_run "UPDATE settings
SET display_format = $(database_quote "$format")
WHERE id = 1;"
  printf '%s\n' "$format"
}

main "$@"
