#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  echo "$0 <name>" >&2
  exit 1
}

# shellcheck source=/dev/null
source "$ROOT_DIR/utils/source.sh"
source_modules \
  utils/abc.sh

main() {
  local file
  [ "$#" -eq 1 ] || usage
  file=$(abc_file "$1")
  abc_titles "$file"
}

main "$@"
